# Database. Leave empty or omit to use the local SQLite file ./linelens.db.
# PostgreSQL example: postgresql+psycopg://linelens:password@localhost:5432/linelens
DATABASE_URL=

# Use a long random value in any shared or production environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# gemini (default), groq, or fake.
# If no matching API key is configured, LineLens uses the deterministic fake provider
# so the app can still be run locally without secrets.
LLM_PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Request limits. The defaults match the product requirements.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_AI_LIMIT=50
MAX_CODE_CHARS=5000
MAX_CODE_LINES=300
