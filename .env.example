# development (default) or production. When ENV=production, startup fails if
# JWT_SECRET is still the development placeholder.
ENV=development

# Database. Leave empty or omit to use the local SQLite file ./linelens.db.
# PostgreSQL example: postgresql+psycopg://linelens:password@localhost:5432/linelens
DATABASE_URL=

# Use a long random value in any shared or production environment.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# gemini (default), groq, or fake.
# If no matching API key is configured, LineLens uses the deterministic fake provider
# so the app can still be run locally without secrets.
LLM_PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Free Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Request limits. The defaults match the product requirements.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
DAILY_AI_LIMIT=50
MAX_CODE_CHARS=5000
MAX_CODE_LINES=300

# Code execution (the Run button). Execution is a subprocess with a timeout,
# not a hardened sandbox; keep this limit modest on a public deployment.
RUN_RATE_LIMIT_REQUESTS=20
RUN_RATE_LIMIT_WINDOW_SECONDS=60
RUN_TIMEOUT_SECONDS=5

# Execution tracing (the step-through view behind Explain). The tracer runs in
# a separate python -I child with an import allowlist and these caps. The
# memory limit uses RLIMIT_AS on POSIX and is skipped on Windows.
TRACE_TIMEOUT_SECONDS=3
TRACE_MAX_EVENTS=500
TRACE_MAX_OUTPUT_CHARS=10000
TRACE_MEMORY_LIMIT_MB=256
